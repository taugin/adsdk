<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="#FFFFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <RelativeLayout
            android:id="@+id/kom_native_cover_info"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/kom_black_bg">

            <ImageView
                android:id="@+id/kom_native_image_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <FrameLayout
                android:id="@+id/kom_native_media_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:contentDescription="@null"
                android:gravity="center" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="4dp"
            android:layout_toStartOf="@+id/rab_native_action_btn_layout"
            android:layout_toEndOf="@+id/kom_native_cover_info"
            android:layout_weight="1"
            android:minHeight="56dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/kom_native_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/kom_native_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/common_sponsored_label"
                    android:ellipsize="end"
                    android:gravity="start|top"
                    android:lines="1"
                    android:maxLines="1"
                    android:minHeight="24dp"
                    android:text="Charge Master"
                    android:textColor="@android:color/black"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/kom_native_social"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:ellipsize="marquee"
                android:gravity="start|top"
                android:singleLine="true"
                android:textColor="@color/komTextSecondaryColor"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/kom_native_detail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="1dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:lines="2"
                android:maxLines="2"
                android:minHeight="24dp"
                android:text="Charge Master"
                android:textColor="@color/komTextSecondaryColor"
                android:textSize="14sp" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rab_native_action_btn_layout"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/kom_native_action_btn"
                style="@style/KomButtonMicroStyle"
                android:layout_width="wrap_content"
                android:layout_alignParentStart="true"
                android:background="@drawable/kom_action_bg"
                android:ellipsize="end"
                android:gravity="center"
                android:maxWidth="120dp"
                android:maxLines="2"
                android:text="Learn More"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/kom_native_sponsored_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:background="@drawable/kom_badge_bg"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="AD"
        android:textColor="@android:color/black"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/kom_native_ad_choices_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:padding="1dp" />
</FrameLayout>